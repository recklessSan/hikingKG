BOT_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# ID чатов-источников (бот должен быть добавлен в них, privacy mode выключен)
CHAT_1_ID=
CHAT_2_ID=
CHAT_3_ID=
CHAT_3_MODE=auto

# Куда слать ежедневный отчёт и кто может вызывать команды
ADMIN_CHAT_ID=
ADMIN_USER_IDS=

TIMEZONE=Europe/Moscow
REPORT_HOUR=21
REPORT_MINUTE=0

# На Heroku: https://<app-name>.herokuapp.com
WEBHOOK_URL=
WEBHOOK_PATH=telegram
PORT=8443

# Справочник телефонов для проверки чата 1 (CSV: phone,label)
PHONES_FILE=phones.csv
