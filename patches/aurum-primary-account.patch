+async def test_by_currency_keeps_kgs_and_usd_separate(client: AsyncClient, account_id, categories):
+    """A som expense and a dollar expense must not be added into one spent total."""
+    kgs = await client.post(
+        "/accounts", json={"name": "Elcart", "type": "debit_card", "currency": "KGS"}
+    )
+    usd = await client.post(
+        "/accounts", json={"name": "Visa USD", "type": "debit_card", "currency": "USD"}
+    )
+    groceries = categories["Groceries"]["id"]
+    salary = categories["Salary"]["id"]
+
+    await client.post(
+        "/transactions",
+        json=_txn(kgs.json()["id"], type="income", amount="1000.00", category_id=salary, date="2026-08-01"),
+    )
+    await client.post(
+        "/transactions",
+        json=_txn(kgs.json()["id"], amount="250.50", category_id=groceries, date="2026-08-02"),
+    )
+    await client.post(
+        "/transactions",
+        json=_txn(usd.json()["id"], type="income", amount="80.00", category_id=salary, date="2026-08-03"),
+    )
+    await client.post(
+        "/transactions",
+        json=_txn(usd.json()["id"], amount="20.00", category_id=groceries, date="2026-08-04"),
+    )
+
+    resp = await client.get("/dashboard/summary", params={"year": 2026, "month": 8})
+    body = resp.json()
+    by_currency = {row["currency"]: row for row in body["by_currency"]}
+
+    assert set(by_currency) >= {"KGS", "USD"}
+    assert money(by_currency["KGS"]["real_income"]) == Decimal("1000.00")
+    assert money(by_currency["KGS"]["spent"]) == Decimal("250.50")
+    assert money(by_currency["KGS"]["net"]) == Decimal("749.50")
+    assert money(by_currency["USD"]["real_income"]) == Decimal("80.00")
+    assert money(by_currency["USD"]["spent"]) == Decimal("20.00")
+    assert money(by_currency["USD"]["net"]) == Decimal("60.00")
+
+    kgs_breakdown = {row["name"]: row for row in by_currency["KGS"]["spending_by_category"]}
+    assert money(kgs_breakdown["Groceries"]["amount"]) == Decimal("250.50")
